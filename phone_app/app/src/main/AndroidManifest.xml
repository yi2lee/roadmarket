<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 앱이 뒤에 있어도 요청을 알려 주는 서비스와 알림에 써요. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- CAMERA 권한은 일부러 선언하지 않아요. 선언하면 카메라 앱을 부를 때도 허용을 받아야 해요. -->

    <!-- 안드로이드 11부터는 다른 앱을 찾으려면 여기 적어야 해요. -->
    <queries>
        <package android:name="com.kakao.talk" />
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/AppTheme">
        <!-- 화면은 하나예요. 키보드나 크기가 바뀌어도 WebView를 새로 만들지 않아요. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation"
            android:windowSoftInputMode="adjustResize|stateHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 뒤에서 서버에 묻는 서비스예요. dataSync는 안드로이드 15에서 하루 6시간 제한이 있어 쓰지 않아요. -->
        <service
            android:name=".WatchService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Waits for buy requests on items the user listed for sale and alerts the seller right away, so a buyer who is driving nearby is not left waiting. Polls a read-only status endpoint while the user is logged in; stops on logout." />
        </service>
    </application>
</manifest>
